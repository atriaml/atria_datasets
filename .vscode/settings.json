{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.claude": true,
        "**/.codex": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/.aws": true,
        "**/.agents": true,
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}